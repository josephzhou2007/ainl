# ~/.ainl/env — the secrets the services read at start. chmod 600. NEVER commit.
# scripts/macos/run.sh sources this file before starting a service, the same
# way bot_restart.ps1 loads the Windows *User* environment.
#
# Fill in, then:  scripts/macos/service.sh restart bot

CANVAS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=

# Only for the PUBLIC (classmates) bot — a SECOND bot from @BotFather.
TELEGRAM_PUBLIC_BOT_TOKEN=
# Canvas login for classmates (scale-up/viewer.py, runs inside the public bot).
# Both are needed, or approved people are told the login step isn't open yet.
#   AINL_SESSION_KEY: encrypts each person's saved Canvas session. Make it ONCE:
#     .venv/bin/python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#   Losing or changing it makes every saved session unreadable (people log in again).
#   AINL_LOGIN_URL: the public HTTPS page Telegram opens (Cloudflare Tunnel ->
#   127.0.0.1:AINL_VIEWER_PORT), ending in /login.
AINL_SESSION_KEY=
AINL_LOGIN_URL=
# AINL_VIEWER_PORT=8790
#   e.g. AINL_LOGIN_URL=https://example.com/native-bot-learning/login (served under /native-bot-learning)

# Optional
CANVAS_BASE_URL=https://canvas.wisc.edu
AINL_KEEPALIVE_MIN=30
# AINL_HOME=/Users/you/.ainl
